parent="1"><mxGeometry x="290" y="215" width="300" height="80" as="geometry"/></mxCell><mxCell id="feat" value="Features saved to Supabase&lt;br&gt;Mood check-in&lt;br&gt;Routines&lt;br&gt;Journal&lt;br&gt;Reminders&lt;br&gt;Wellness summary&lt;br&gt;Talk board (&quot;I need help&quot;)&lt;br&gt;AI Companion&lt;br&gt;Role dashboards: Individual, Caregiver, Child" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="315" width="300" height="240" as="geometry"/></mxCell><mxCell id="dev" value="Features that run on the device only (not saved yet)&lt;br&gt;Calm tools (breathing, grounding)&lt;br&gt;Module screens: Calm Space, Bright Days, Safe Harbor, Cycle Care&lt;br&gt;Story workflow (caregiver approval)&lt;br&gt;Planned modules: Autism, ADHD" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="290" y="575" width="300" height="205" as="geometry"/></mxCell><mxCell id="sb" value="Supabase (Backend-as-a-Service)" style="swimlane;fontStyle=1;startSize=26;fontSize=13;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="620" height="730" as="geometry"/></mxCell><mxCell id="auth" value="Supabase Auth&lt;br&gt;Email/password sign-in, issues JWT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="270" height="70" as="geometry"/></mxCell><mxCell id="api" value="PostgREST Data API&lt;br&gt;REST over HTTPS, applies RLS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="270" height="70" as="geometry"/></mxCell><mxCell id="ef" value="Edge Functions (Deno)" style="swimlane;fontStyle=1;startSize=26;fontSize=13;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="270" height="490" as="geometry"/></mxCell><mxCell id="ef1" value="Child access&lt;br&gt;verify-child-pin, create-child&lt;br&gt;reset-child-pin, get-child-profile&lt;br&gt;child-settings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="715" y="326" width="240" height="105" as="geometry"/></mxCell><mxCell id="ef2" value="Wellness data&lt;br&gt;mood-checkin, journal, routines&lt;br&gt;reminders, wellness-summary" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="715" y="443" width="240" height="95" as="geometry"/></mxCell><mxCell id="ef3" value="AI and alerts&lt;br&gt;ai-companion, child-alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="715" y="550" width="240" height="62" as="geometry"/></mxCell><mxCell id="ef4" value="Planned (not deployed)&lt;br&gt;safety-check, journal-analysis&lt;br&gt;recommendations&lt;br&gt;emergency-escalation&lt;br&gt;ai-orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="715" y="624" width="240" height="140" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL Database&lt;br&gt;Row Level Security on every table&lt;br&gt;&lt;br&gt;profiles, children&lt;br&gt;child_caregivers, caregiver_invites&lt;br&gt;caregiver_user_links&lt;br&gt;condition_modules, child_modules&lt;br&gt;mood_checkins, journal_entries&lt;br&gt;routines, routine_step_completions&lt;br&gt;reminders, reminder_acknowledgements&lt;br&gt;ai_companion_conversations&lt;br&gt;ai_companion_messages&lt;br&gt;emergency_events, pin_attempts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="200" width="280" height="340" as="geometry"/></mxCell><mxCell id="gem" value="Google Gemini API&lt;br&gt;(LLM for AI Companion)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1370" y="550" width="230" height="70" as="geometry"/></mxCell><mxCell id="qd" value="Qdrant vector DB (RAG)&lt;br&gt;Planned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1370" y="640" width="230" height="60" as="geometry"/></mxCell><mxCell id="push" value="SMS / push alerts&lt;br&gt;Planned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1370" y="720" width="230" height="60" as="geometry"/></mxCell><mxCell id="legend" value="Solid = implemented&lt;br&gt;Dashed = planned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1370" y="70" width="230" height="60" as="geometry"/></mxCell><mxCell id="rules" value="Access rules enforced inside PostgreSQL (RLS)&lt;br&gt;Caregivers reach a child only through is_caregiver_of() (primary or co-caregiver)  |  Under 15: activity is shared with caregivers; 15 and over: the young person chooses  |  Help alerts always reach every caregiver  |  A child has no Supabase Auth account: verify-child-pin issues a signed child session token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1570" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="u1" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="u2" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="u3" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cl" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.7;" edge="1" parent="1" source="ef" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTPS, server-side API key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ef3" target="gem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.4;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="ef4" target="qd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.8;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="ef4" target="push"><mxGeometry relative="1" as="geome