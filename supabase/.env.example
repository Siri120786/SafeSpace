# Copy to supabase/.env.local (used by `pnpm functions:serve`).
# For hosted projects set these with: supabase secrets set NAME=value
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Long random string used to sign child-session tokens. Generate with: openssl rand -hex 32
CHILD_SESSION_SECRET=change-me

# Add your LLM / speech-to-text provider keys here when you wire up ai-orchestrator, e.g.:
# LLM_API_KEY=
# STT_API_KEY=
